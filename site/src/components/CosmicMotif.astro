---
/*
  The Living Order — motif & pattern system.
  Ported from Design/Dr. Javed Jamil's Living Order/Javed Jamil Brand Identity.dc.html,
  section "08 — Motif & Pattern System": concentric tiers + orbital arc struck from a
  single off-frame centre, plus an optional life-rhythm line. Reads as scientific
  diagrammatics, not wallpaper — this is a background layer, not a repeating tile.

  Intended use: position:absolute background inside a position:relative section,
  with overflow:hidden on the section.
*/
interface Props {
  width?: number;
  height?: number;
  /** center of the concentric rings, in viewBox units. Defaults to off-frame right. */
  cx?: number;
  cy?: number;
  ringCount?: number;
  ringStep?: number;
  ringStroke?: string;
  ringOpacity?: number;
  accent?: string;
  /** draws the orbital ellipse + node — "relativity & motion" */
  showOrbit?: boolean;
  orbitRx?: number;
  orbitRy?: number;
  orbitRotate?: number;
  /** draws the wavy life-rhythm line — use sparingly, one per composition */
  showPulseLine?: boolean;
  class?: string;
}

const {
  width = 1200,
  height = 600,
  cx = width * 0.9,
  cy = height * 0.5,
  ringCount = 4,
  ringStep = 140,
  ringStroke = "var(--parchment)",
  ringOpacity = 0.12,
  accent = "var(--accent)",
  showOrbit = true,
  orbitRx = 360,
  orbitRy = 130,
  orbitRotate = -18,
  showPulseLine = false,
  class: className = "",
} = Astro.props;

const rings = Array.from({ length: ringCount }, (_, i) => (i + 1) * ringStep + 20);
const nodeAngle = (-orbitRotate * Math.PI) / 180;
const nodeX = cx + orbitRx * Math.cos(nodeAngle) * 0.72;
const nodeY = cy - orbitRy * Math.sin(nodeAngle) * 0.72;
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  class={className}
  style="position:absolute; inset:0; width:100%; height:100%;"
>
  <g fill="none" stroke={ringStroke} stroke-width="1" opacity={ringOpacity}>
    {rings.map((r) => <circle cx={cx} cy={cy} r={r}></circle>)}
  </g>

  {showOrbit && (
    <>
      <ellipse
        cx={cx}
        cy={cy}
        rx={orbitRx}
        ry={orbitRy}
        fill="none"
        stroke={accent}
        stroke-width="1.4"
        opacity=".7"
        transform={`rotate(${orbitRotate} ${cx} ${cy})`}
      ></ellipse>
      <circle cx={nodeX} cy={nodeY} r="6" fill={accent}></circle>
    </>
  )}

  {showPulseLine && (
    <path
      d={`M0 ${cy} Q ${width * 0.08} ${cy - 40} ${width * 0.16} ${cy} T ${width * 0.33} ${cy} T ${width * 0.5} ${cy} T ${width * 0.66} ${cy} T ${width * 0.83} ${cy} T ${width} ${cy}`}
      fill="none"
      stroke={accent}
      stroke-width="1.6"
      opacity=".85"
    ></path>
  )}
</svg>
