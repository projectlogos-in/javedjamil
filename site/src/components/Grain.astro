---
/*
  Film grain — one fixed, non-interactive overlay for the whole document.
  Inline SVG turbulence rather than a raster so it costs nothing to ship and
  scales to any viewport. It takes the digital flatness off the dark grounds.
*/
---

<svg class="grain" aria-hidden="true" focusable="false">
  <filter id="grain-noise">
    <feTurbulence type="fractalNoise" baseFrequency="0.82" numOctaves="3" stitchTiles="stitch" />
    <feColorMatrix type="saturate" values="0" />
  </filter>
  <rect width="100%" height="100%" filter="url(#grain-noise)" />
</svg>
