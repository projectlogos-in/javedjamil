---
/*
  A title's cover. Where the house holds a real plate we show it; where it does
  not, we fall back to the typographic house cover — the same locked 2:3 field,
  set in Garamond with the movement's rule at the foot, so an incomplete shelf
  still reads as one shelf.
*/
import { base } from "../lib/base";

const MOVEMENTS: Record<string, { label: string; numeral: string }> = {
  recovery: { label: "Recovery", numeral: "I" },
  diagnosis: { label: "Diagnosis", numeral: "II" },
  reconstruction: { label: "Reconstruction", numeral: "III" },
  foundations: { label: "Foundations", numeral: "IV" },
};

interface Props {
  title: string;
  subtitle?: string;
  movement: string;
  shelf?: string;
  cover?: string;
  year?: string;
  loading?: "lazy" | "eager";
}

const { title, subtitle, movement, shelf, cover, year, loading = "lazy" } = Astro.props;
const mv = MOVEMENTS[movement] ?? { label: movement, numeral: "" };
---

<div class:list={["cover", { "cover--plate": !!cover }]} style={`--mv: var(--mv-${movement}); --mv-lum: var(--mv-${movement}-lum)`}>
  {
    cover ? (
      <img src={`${base}${cover}`} alt={`Cover of ${title}`} class="cover__img" loading={loading} width="400" height="600" />
    ) : (
      <div class="cover__set">
        <div class="cover__rule" aria-hidden="true" />
        <div class="cover__movement">
          {mv.numeral} · {mv.label}
        </div>
        <div class="cover__title">{title}</div>
        {subtitle && <div class="cover__subtitle">{subtitle}</div>}
        <div class="cover__foot">
          <span>Javed Jamil</span>
          {year && <span class="cover__year">{year}</span>}
        </div>
      </div>
    )
  }

  {shelf && <span class="cover__shelf" aria-hidden="true">{shelf}</span>}
  <span class="cover__gloss" aria-hidden="true"></span>
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    background: var(--paper);
    box-shadow: var(--lift-2);
    overflow: hidden;
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .cover:hover {
    box-shadow: var(--lift-3), 0 0 40px -14px color-mix(in srgb, var(--mv-lum) 60%, transparent);
  }

  .cover__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---- typographic fallback ---- */
  .cover__set {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 12% 11% 10%;
    background: linear-gradient(178deg, var(--paper) 0%, var(--parchment) 100%);
    color: var(--ink);
  }

  .cover__rule {
    height: 2px;
    background: var(--mv);
    margin-bottom: 14%;
  }

  .cover__movement {
    font-family: var(--font-ui);
    font-size: clamp(7px, 0.85vw, 9px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mv);
    margin-bottom: 8%;
  }

  .cover__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.5vw, 1.32rem);
    line-height: 1.16;
  }

  .cover__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.72rem, 1vw, 0.9rem);
    line-height: 1.3;
    color: var(--light-text-muted);
    margin-top: 6%;
  }

  .cover__foot {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 0.95vw, 0.85rem);
    color: var(--light-text-muted);
    border-top: 1px solid var(--light-hairline);
    padding-top: 7%;
  }

  .cover__year {
    font-family: var(--font-mono);
    font-size: 0.78em;
    color: var(--light-text-faint);
  }

  /* ---- shelfmark tab ---- */
  .cover__shelf {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 5px 9px;
    background: var(--mv);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    z-index: 2;
  }

  /* specular sheet tracking the pointer, via --gloss-x/y from the tilt engine */
  .cover__gloss {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      46% 46% at var(--gloss-x, 50%) var(--gloss-y, 50%),
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0) 74%
    );
    transition: opacity var(--dur) var(--ease-out);
  }

  .cover:hover .cover__gloss {
    opacity: 1;
  }
</style>
