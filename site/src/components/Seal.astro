---
/*
  The Living Order — primary mark.
  Ported from Design/Dr. Javed Jamil's Living Order/Javed Jamil Brand Identity.dc.html
  (sections 02 "Primary Mark" and 02·B "Qur'anic Anchoring").

  variant:
    "geometric"  — Route C pure geometric seal. No letterform. Survives to 16px.
                   Use for nav, favicon-scale marks, avatars, signatures.
    "ceremonial" — Qur'an 67:3 ring-inscription. Use only at >=28mm / hero / print /
                   book covers / certificates — never shrink below legibility.

  mode: "dark" (default, for ink grounds) | "light" (for parchment/bone grounds)
        | "mono" (single currentColor, for print/favicon) | "foil" (gold gradient)
*/
interface Props {
  variant?: "geometric" | "ceremonial";
  mode?: "dark" | "light" | "mono" | "foil";
  size?: number;
  animated?: boolean;
  class?: string;
}

const {
  variant = "geometric",
  mode = "dark",
  size = 64,
  animated = true,
  class: className = "",
} = Astro.props;

const uid = `seal-${Math.random().toString(36).slice(2, 9)}`;

const ringStroke =
  mode === "light" ? "var(--ink)" : mode === "mono" ? "currentColor" : mode === "foil" ? `url(#${uid}-foil)` : "var(--parchment)";
const accentFill = mode === "mono" ? "currentColor" : mode === "foil" ? `url(#${uid}-foil)` : "var(--accent)";
---

<svg
  viewBox={variant === "ceremonial" ? "0 0 280 280" : "0 0 240 240"}
  width={size}
  height={size}
  role="img"
  aria-label={variant === "ceremonial" ? "Dr. Javed Jamil ceremonial seal — Qur'an 67:3 ringing the cosmology" : "Dr. Javed Jamil seal"}
  class={className}
>
  {mode === "foil" && (
    <defs>
      <linearGradient id={`${uid}-foil`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#F4D88A"></stop>
        <stop offset=".5" stop-color="#BE8A2C"></stop>
        <stop offset="1" stop-color="#7A571A"></stop>
      </linearGradient>
    </defs>
  )}

  {variant === "geometric" ? (
    <>
      <g class={animated ? "ping" : ""} style="transform-origin: 120px 120px;">
        <circle cx="120" cy="120" r="26" fill="none" stroke={accentFill} stroke-width="1.4"></circle>
      </g>
      <circle cx="120" cy="120" r="110" fill="none" stroke={ringStroke} stroke-width="2"></circle>
      <circle cx="120" cy="120" r="58" fill="none" stroke={ringStroke} stroke-width="1.2"></circle>
      <g stroke={ringStroke} stroke-width="1.4">
        <line x1="120" y1="14" x2="120" y2="26"></line>
        <g transform="rotate(51.4 120 120)"><line x1="120" y1="14" x2="120" y2="26"></line></g>
        <g transform="rotate(102.8 120 120)"><line x1="120" y1="14" x2="120" y2="26"></line></g>
        <g transform="rotate(154.2 120 120)"><line x1="120" y1="14" x2="120" y2="26"></line></g>
        <g transform="rotate(205.7 120 120)"><line x1="120" y1="14" x2="120" y2="26"></line></g>
        <g transform="rotate(257.1 120 120)"><line x1="120" y1="14" x2="120" y2="26"></line></g>
        <g transform="rotate(308.5 120 120)"><line x1="120" y1="14" x2="120" y2="26"></line></g>
      </g>
      <g class={animated ? "spin-med" : ""} style="transform-origin: 120px 120px;">
        <ellipse cx="120" cy="120" rx="92" ry="34" fill="none" stroke={ringStroke} stroke-width="1" stroke-dasharray="2 5" opacity=".75" transform="rotate(-24 120 120)"></ellipse>
        <circle cx="206" cy="96" r="5.5" fill={accentFill}></circle>
      </g>
      <circle cx="120" cy="120" r="24" fill="none" stroke={ringStroke} stroke-width="1.4"></circle>
      <circle cx="120" cy="120" r="14" fill={accentFill}></circle>
    </>
  ) : (
    <>
      <defs>
        <path id={`${uid}-ring`} d="M140,266 a126,126 0 1,0 -0.01,0" fill="none"></path>
      </defs>
      <circle cx="140" cy="140" r="138" fill="none" stroke={ringStroke} stroke-width="1.6"></circle>
      <circle cx="140" cy="140" r="112" fill="none" stroke={ringStroke} stroke-width=".7" opacity=".55"></circle>
      <text dir="rtl" font-family="'Amiri',serif" font-size="19" font-weight="700" fill={mode === "light" ? "var(--graphite)" : "#EDE7DA"} letter-spacing="1">
        <textPath href={`#${uid}-ring`} startOffset="50%" text-anchor="middle">الَّذِي خَلَقَ سَبْعَ سَمَاوَاتٍ طِبَاقًا</textPath>
      </text>
      <g fill="none" stroke={ringStroke} stroke-width=".8">
        <circle cx="140" cy="140" r="34" opacity=".9"></circle>
        <circle cx="140" cy="140" r="44" opacity=".8"></circle>
        <circle cx="140" cy="140" r="54" opacity=".72"></circle>
        <circle cx="140" cy="140" r="64" opacity=".64"></circle>
        <circle cx="140" cy="140" r="74" opacity=".56"></circle>
        <circle cx="140" cy="140" r="84" opacity=".48"></circle>
        <circle cx="140" cy="140" r="94" opacity=".4"></circle>
      </g>
      <g class={animated ? "spin-rev" : ""} style="transform-origin: 140px 140px;">
        <ellipse cx="140" cy="140" rx="100" ry="38" fill="none" stroke={accentFill} stroke-width="1.3" transform="rotate(-24 140 140)"></ellipse>
        <circle cx="226" cy="114" r="5.5" fill={accentFill}></circle>
      </g>
      <circle cx="140" cy="140" r="23" fill={mode === "light" ? "var(--parchment)" : "var(--void)"}></circle>
      <circle cx="140" cy="140" r="23" fill="none" stroke={ringStroke} stroke-width="1.3"></circle>
      <g class={animated ? "breathe" : ""} style="transform-origin: 140px 140px;">
        <circle cx="140" cy="140" r="13" fill={accentFill}></circle>
      </g>
    </>
  )}
</svg>
