---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Seal from "../components/Seal.astro";
import TierField from "../components/TierField.astro";
import BookCover from "../components/BookCover.astro";
import { base } from "../lib/base";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const books = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
const featuredBooks = [
  "the-devil-of-economic-fundamentalism",
  "rediscovering-the-universe",
  "a-systematic-study-of-the-holy-quran",
  "the-killer-sex",
]
  .map((id) => books.find((b) => b.id === id))
  .filter(Boolean);

const terms = (await getCollection("lexicon")).sort((a, b) => a.data.term.localeCompare(b.data.term));

// the five fields the work actually spans — each a "tier" of the argument
const tiers = [
  {
    n: "01",
    field: "Health",
    color: "var(--domain-health)",
    title: "The Dynamic Paradigm of Health",
    body: "Health is not a state to be restored after the fact, but a living process an entire civilisation either sustains or degrades. Every tax code is a health policy.",
    href: `${base}health-maximisation/`,
  },
  {
    n: "02",
    field: "Economics",
    color: "var(--domain-economics)",
    title: "Economic Fundamentalism",
    body: "The ideology that gives economics predominance over every other sphere of life — indifferent to what it costs in health, family peace, and social order.",
    href: `${base}lexicon/economic-fundamentalism/`,
  },
  {
    n: "03",
    field: "Physics",
    color: "var(--domain-physics)",
    title: "The Universal Theory of Relativity",
    body: "A century of cosmology described a universe that had lost its virility — passive, hollowing, governed by nothing. The proposal is to restore its order.",
    href: `${base}books/rediscovering-the-universe/`,
  },
  {
    n: "04",
    field: "Political Thought",
    color: "var(--domain-political)",
    title: "The Natural World Order",
    body: "Against the New World Order of markets: a system weighted equally on Fundamental Rights, Fundamental Duties, and the Fundamental Prohibitions the market abhors.",
    href: `${base}lexicon/natural-world-order/`,
  },
  {
    n: "05",
    field: "Qur'anic Studies",
    color: "var(--domain-quranic)",
    title: "Applied Islamics",
    body: "Not Islam studied through the lens of modernity, but modernity examined in the light of the Qur'an — as a discipline, with alternative models proposed in place of what it dismantles.",
    href: `${base}books/applied-islamics/`,
  },
];
---

<BaseLayout title="Dr. Javed Jamil">
  <!-- ══════════════════ I · THE HERO ══════════════════ -->
  <section class="hero" data-pointer-scene>
    <TierField cx={72} cy={44} scale={1.15} pointer class="hero__field" />

    <div class="hero__inner">
      <div class="hero__eyebrow-row" data-reveal="fade">
        <span class="rule-node hero__rule"></span>
        <span class="eyebrow">Applied Islamics</span>
      </div>

      <h1 class="hero__title reveal-lines" data-reveal="fade">
        <span class="line"><span>Javed</span></span>
        <span class="line"><span>Jamil</span></span>
      </h1>

      <div class="hero__scripts" data-reveal data-reveal-delay="380">
        <span dir="rtl" lang="ur" class="hero__urdu">ڈاکٹر جاوید جمیل</span>
        <span class="hero__script-div" aria-hidden="true"></span>
        <span dir="rtl" lang="ar" class="hero__arabic">د. جاويد جميل</span>
      </div>

      <p class="hero__role" data-reveal data-reveal-delay="480">
        Physician &nbsp;·&nbsp; Islamic scholar &nbsp;·&nbsp; Poet &nbsp;·&nbsp; Originator of Applied Islamics
      </p>

      <p class="hero__claim" data-reveal data-reveal-delay="580">
        The modern world is the patient on the table.<br />
        <em>The Qur'an is the lens.</em>
      </p>

      <div class="hero__cta" data-stagger data-reveal-delay="700">
        <a href={`${base}ideas/`} class="button button--solid">Read the essays</a>
        <a href={`${base}books/`} class="button button--outline">18 works &rarr;</a>
      </div>
    </div>

    <a href="#inversion" class="hero__scroll" aria-label="Scroll to the argument">
      <span class="hero__scroll-label">The argument</span>
      <span class="hero__scroll-line"><span></span></span>
    </a>
  </section>

  <!-- ══════════════════ II · THE INVERSION (scroll-scrubbed) ══════════════════ -->
  <section class="inversion" id="inversion" data-scrub>
    <div class="inversion__sticky">
      <div class="inversion__grid">
        <!-- left: the two readings of the same world -->
        <div class="inversion__copy">
          <div class="eyebrow eyebrow--dim">The Inversion</div>

          <div class="inversion__states">
            <div class="inversion__state inversion__state--before">
              <div class="inversion__state-label">The order we have</div>
              <h2 class="inversion__state-title">Everything orbits the market.</h2>
              <p>
                For three centuries economics has held the centre, and everything else — health, family, law,
                science, life itself — has been made to orbit it. The cost is measurable, and it is
                catastrophic.
              </p>
            </div>

            <div class="inversion__state inversion__state--after">
              <div class="inversion__state-label">The order proposed</div>
              <h2 class="inversion__state-title">Everything orbits life.</h2>
              <p>
                Put health and life at the centre and subordinate politics and economics to that single end.
                Not a moral preference — an optimisation target, and a measurable one.
              </p>
            </div>
          </div>

          <a href={`${base}health-maximisation/`} class="inversion__link link-draw">
            The Dynamic Paradigm of Health &rarr;
          </a>
        </div>

        <!-- right: the diagram that performs the argument -->
        <div class="inversion__diagram">
          <svg viewBox="-260 -260 520 520" class="inversion__svg" role="img" aria-label="Diagram: the centre of the order shifts from the market to health">
            <!-- fixed scaffolding -->
            <g fill="none" stroke="var(--ink-text)" opacity="0.14">
              <circle cx="0" cy="0" r="96" stroke-width="1" />
              <circle cx="0" cy="0" r="160" stroke-width="1" />
              <circle cx="0" cy="0" r="220" stroke-width="1" stroke-dasharray="3 7" />
            </g>

            <!-- the rotating system: satellites swap places across the scrub -->
            <g class="inversion__system">
              <g class="inversion__sat" style="--a: 0">
                <circle r="7" fill="var(--gold-lum)" />
                <text y="-20" text-anchor="middle" class="inversion__sat-label">Politics</text>
              </g>
              <g class="inversion__sat" style="--a: 120">
                <circle r="7" fill="var(--gold-lum)" />
                <text y="-20" text-anchor="middle" class="inversion__sat-label">Law</text>
              </g>
              <g class="inversion__sat" style="--a: 240">
                <circle r="7" fill="var(--gold-lum)" />
                <text y="-20" text-anchor="middle" class="inversion__sat-label">Science</text>
              </g>
            </g>

            <!-- the two centres, crossfading -->
            <g class="inversion__core inversion__core--before">
              <circle r="66" fill="var(--crimson)" opacity="0.16" />
              <circle r="52" fill="var(--crimson)" />
              <text text-anchor="middle" y="6" class="inversion__core-label">MARKET</text>
            </g>

            <g class="inversion__core inversion__core--after">
              <circle r="72" fill="var(--accent-lum)" opacity="0.18" class="ping" />
              <circle r="52" fill="var(--accent)" />
              <circle r="52" fill="none" stroke="var(--accent-lum)" stroke-width="1.4" />
              <text text-anchor="middle" y="6" class="inversion__core-label">HEALTH</text>
            </g>
          </svg>

          <div class="inversion__scrub-rail" aria-hidden="true"><span></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════ III · THE EMPIRICAL CLAIM ══════════════════ -->
  <section class="claim">
    <div class="claim__inner">
      <div class="claim__figure" data-reveal="scale">
        <span class="claim__number" data-count="80" data-count-suffix="M">0</span>
        <span class="claim__unit">lives, every year</span>
      </div>
      <div class="claim__body" data-reveal>
        <p>
          The estimate at the centre of the work: the annual, preventable human cost of a civilisation
          optimised for profit rather than life. Alcohol, tobacco, commercial sex, the industrialised food
          chain, and a health system that treats consequences while the causes stay licensed and taxed.
        </p>
        <p class="claim__aside">
          It is a physician's accounting, and it is meant to be argued with on the evidence.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════ IV · THE SEVEN TIERS / FIVE FIELDS ══════════════════ -->
  <section class="tiers">
    <div class="tiers__head">
      <div class="eyebrow" data-reveal="fade">Five fields, one argument</div>
      <h2 class="tiers__title reveal-lines" data-reveal="fade">
        <span class="line"><span>A single thesis, pressed</span></span>
        <span class="line"><span>into every discipline</span></span>
      </h2>
      <p class="tiers__lead" data-reveal>
        Medicine, economics, cosmology, political theory, Qur'anic exegesis. The claim in each is the same
        claim, which is why the work refuses to stay in one department.
      </p>
    </div>

    <ol class="tiers__list">
      {
        tiers.map((tier) => (
          <li class="tier" data-reveal style={`--tier-color: ${tier.color}`}>
            <a href={tier.href} class="tier__link">
              <span class="tier__n">{tier.n}</span>
              <span class="tier__field">{tier.field}</span>
              <span class="tier__content">
                <span class="tier__title">{tier.title}</span>
                <span class="tier__body">{tier.body}</span>
              </span>
              <span class="tier__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ══════════════════ V · THE APHORISM ══════════════════ -->
  <section class="aphorism">
    <div class="aphorism__bleed bleed bleed--gold"></div>
    <blockquote class="aphorism__quote" data-reveal="scale">
      <span class="aphorism__mark" aria-hidden="true">“</span>
      Islam is, perforce, a future-oriented world-view.
    </blockquote>
    <div class="aphorism__attr" data-reveal>Dr. Javed Jamil</div>
  </section>

  <!-- ══════════════════ VI · THE WORKS ══════════════════ -->
  <section class="works">
    <div class="works__head">
      <div>
        <div class="eyebrow" data-reveal="fade">Mission Publications</div>
        <h2 class="works__title" data-reveal>The Works</h2>
      </div>
      <p class="works__lead" data-reveal>
        Eighteen titles across health, economics, physics, political thought and Qur'anic studies — colour-banded
        by field, as one continuous body of work rather than a bibliography.
      </p>
    </div>

    <div class="works__shelf" data-stagger>
      {
        featuredBooks.map((book) => (
          <a href={`${base}books/${book!.id}/`} class="works__item" data-tilt="9">
            <BookCover title={book!.data.title} domain={book!.data.domain} color={book!.data.color} />
          </a>
        ))
      }
    </div>

    <a href={`${base}books/`} class="button button--outline works__all" data-reveal>The full library &rarr;</a>
  </section>

  <!-- ══════════════════ VII · THE LEXICON ══════════════════ -->
  <section class="lexicon-strip">
    <div class="lexicon-strip__inner">
      <div class="lexicon-strip__head" data-reveal>
        <div class="eyebrow">The Lexicon</div>
        <h2 class="lexicon-strip__title">He had to coin the terms first</h2>
        <p>
          An argument this far outside the consensus needs vocabulary the consensus doesn't supply. Each term
          links to the essays and books that build it.
        </p>
      </div>

      <div class="lexicon-strip__terms" data-stagger>
        {
          terms.map((term) => (
            <a href={`${base}lexicon/${term.id}/`} class="lexicon-chip">
              <span class="lexicon-chip__term">{term.data.term}</span>
              {term.data.category && <span class="lexicon-chip__cat">{term.data.category}</span>}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════════════ VIII · LATEST WRITING ══════════════════ -->
  <section class="latest">
    <div class="latest__head">
      <div class="eyebrow" data-reveal="fade">Latest writing</div>
      <a href={`${base}ideas/`} class="latest__all link-draw" data-reveal>All essays &amp; series &rarr;</a>
    </div>

    <div class="latest__list" data-stagger>
      {
        posts.map((post, i) => (
          <a href={`${base}ideas/${post.id}/`} class="latest__row">
            <span class="latest__index">{String(i + 1).padStart(2, "0")}</span>
            <span class="latest__main">
              <span class="latest__row-title">{post.data.title}</span>
              {post.data.excerpt && <span class="latest__excerpt">{post.data.excerpt}</span>}
            </span>
            <time class="latest__date" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" })}
            </time>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ══════════════════ IX · CLOSE ══════════════════ -->
  <section class="close">
    <TierField cx={50} cy={50} scale={1.4} pulseLine={false} class="close__field" />
    <div class="close__inner">
      <Seal variant="ceremonial" mode="dark" size={168} class="close__seal" />
      <p class="close__verse" dir="rtl" lang="ar" data-reveal>الَّذِي خَلَقَ سَبْعَ سَمَاوَاتٍ طِبَاقًا</p>
      <p class="close__gloss" data-reveal>“Who created seven heavens in layers.” &mdash; Al-Mulk 67:3</p>
      <div class="close__cta" data-stagger>
        <a href={`${base}about/`} class="button button--outline">The biography</a>
        <a href={`${base}ideas/`} class="button button--solid">Begin reading</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══════════ I · HERO ═══════════ */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 74% 42%, rgba(22, 29, 64, 0.85) 0%, rgba(8, 12, 28, 0) 62%),
      linear-gradient(180deg, var(--ink) 0%, var(--void) 100%);
    padding: clamp(72px, 11vh, 120px) var(--section-pad-x) clamp(96px, 16vh, 150px);
  }

  /* a scrim that darkens the left third, so the copy never has to compete
     with the tier lines running underneath it */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(100deg, var(--void) 0%, rgba(4, 6, 14, 0.72) 26%, rgba(4, 6, 14, 0) 58%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--wide-max);
    margin: 0 auto;
    width: 100%;
  }

  .hero__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 30px;
    max-width: 420px;
    color: var(--accent-lum);
  }

  .hero__rule {
    max-width: 74px;
  }

  .hero__rule::after {
    display: none;
  }

  .hero__title {
    font-size: var(--step-hero);
    line-height: 0.86;
    letter-spacing: -0.035em;
    margin: 0 0 26px;
    color: var(--ink-text);
  }

  .hero__title .line > span {
    /* the second line steps in, so the name reads as a stacked lockup */
    display: block;
  }

  .hero__title .line:nth-child(2) > span {
    padding-left: 0.14em;
    color: transparent;
    background: linear-gradient(96deg, var(--ink-text) 24%, var(--gold-lum) 88%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero__scripts {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: clamp(16px, 3vh, 26px);
    flex-wrap: wrap;
  }

  .hero__urdu {
    font-family: var(--font-urdu);
    font-size: clamp(19px, 2.2vw, 27px);
    line-height: 2.1;
    color: var(--ink-text-muted);
  }

  .hero__arabic {
    font-family: var(--font-arabic);
    font-size: clamp(20px, 2.3vw, 28px);
    color: var(--ink-text-muted);
  }

  .hero__script-div {
    width: 1px;
    height: 26px;
    background: var(--ink-hairline-strong);
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: clamp(10.5px, 1.15vw, 12.5px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
    margin: 0 0 clamp(24px, 4vh, 40px);
  }

  .hero__claim {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, min(2.4vw, 3.2vh), 2.1rem);
    line-height: 1.28;
    color: var(--ink-text);
    margin: 0 0 clamp(28px, 4.5vh, 44px);
    max-width: 22ch;
  }

  .hero__claim em {
    color: var(--accent-lum);
    font-style: italic;
  }

  .hero__cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero__scroll {
    position: absolute;
    left: var(--section-pad-x);
    bottom: 42px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--ink-text-faint);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hero__scroll:hover {
    color: var(--accent-lum);
  }

  .hero__scroll-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .hero__scroll-line {
    display: block;
    width: 76px;
    height: 1px;
    background: var(--ink-hairline-strong);
    overflow: hidden;
  }

  .hero__scroll-line span {
    display: block;
    width: 34%;
    height: 100%;
    background: var(--accent-lum);
    animation: scroll-sweep 2.6s var(--ease-in-out) infinite;
  }

  @keyframes scroll-sweep {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(320%);
    }
  }

  /* ═══════════ II · INVERSION ═══════════ */
  .inversion {
    position: relative;
    /* the tall track is what gives the sticky panel something to scrub against */
    height: 320vh;
    background: linear-gradient(180deg, var(--void) 0%, var(--ink) 30%, var(--ink) 70%, var(--void) 100%);
  }

  .inversion__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 100px var(--section-pad-x);
  }

  .inversion__grid {
    max-width: var(--content-max);
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 7vw, 100px);
    align-items: center;
  }

  .inversion__states {
    position: relative;
    margin: 22px 0 28px;
    min-height: 300px;
  }

  .inversion__state {
    position: absolute;
    inset: 0;
    transition: opacity 0.35s linear, transform 0.5s var(--ease-out);
  }

  /* crossfade the two readings across the middle of the scrub */
  .inversion__state--before {
    opacity: clamp(0, calc(1 - var(--progress, 0) * 2.4), 1);
    transform: translateY(calc(var(--progress, 0) * -26px));
  }

  .inversion__state--after {
    opacity: clamp(0, calc((var(--progress, 0) - 0.55) * 2.8), 1);
    transform: translateY(calc((1 - var(--progress, 0)) * 26px));
  }

  .inversion__state-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
    margin-bottom: 16px;
  }

  .inversion__state--after .inversion__state-label {
    color: var(--accent-lum);
  }

  .inversion__state-title {
    font-size: var(--step-xl);
    margin-bottom: 20px;
    color: var(--ink-text);
  }

  .inversion__state p {
    font-size: var(--step-md);
    line-height: 1.62;
    color: var(--ink-text-muted);
    max-width: 42ch;
    margin: 0;
  }

  .inversion__link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-lum);
    opacity: clamp(0, calc((var(--progress, 0) - 0.7) * 3.4), 1);
  }

  .inversion__diagram {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .inversion__svg {
    width: min(100%, 480px);
    height: auto;
    overflow: visible;
  }

  /* the system turns a half-revolution across the scrub */
  .inversion__system {
    transform: rotate(calc(var(--progress, 0) * 180deg));
    transition: transform 0.3s linear;
  }

  .inversion__sat {
    /* each satellite sits on the 160-radius ring at its own angle */
    transform: rotate(calc(var(--a) * 1deg)) translate(160px) rotate(calc(var(--a) * -1deg));
  }

  .inversion__sat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--ink-text-faint);
    /* keep labels upright while the system rotates */
    transform: rotate(calc(var(--progress, 0) * -180deg));
    transform-box: fill-box;
    transform-origin: center;
  }

  .inversion__core {
    transition: opacity 0.3s linear;
  }

  .inversion__core--before {
    opacity: clamp(0, calc(1 - var(--progress, 0) * 2.4), 1);
  }

  .inversion__core--after {
    opacity: clamp(0, calc((var(--progress, 0) - 0.55) * 2.8), 1);
  }

  .inversion__core-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    font-weight: 500;
    fill: #fff;
  }

  .inversion__scrub-rail {
    width: min(100%, 320px);
    height: 2px;
    background: var(--ink-hairline);
    overflow: hidden;
  }

  .inversion__scrub-rail span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--crimson), var(--accent-lum));
    transform: scaleX(var(--progress, 0));
    transform-origin: 0 50%;
  }

  /* ═══════════ III · CLAIM ═══════════ */
  .claim {
    background: var(--parchment);
    color: var(--graphite);
    padding: var(--section-pad-y) var(--section-pad-x);
