---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCover from "../../components/BookCover.astro";
import TierField from "../../components/TierField.astro";
import { base } from "../../lib/base";
import { movement } from "../../lib/movements";

export async function getStaticPaths() {
  const books = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
  return books.map((book, i) => ({
    params: { slug: book.id },
    props: { book, next: books[(i + 1) % books.length] },
  }));
}

const { book, next } = Astro.props;
const { Content } = await render(book);
const mv = movement(book.data.movement);
const ap = book.data.apparatus;

const all = (await getCollection("books")).sort((a, b) => a.data.sortYear - b.data.sortYear);
const sameMovement = all.filter((b) => b.data.movement === book.data.movement && b.id !== book.id).slice(0, 5);

// the apparatus block, as ordered rows
const rows = [
  ["Movement", mv ? `${mv.numeral} · ${mv.name}` : book.data.movement],
  ["Shelfmark", book.data.shelf],
  ["First published", book.data.year],
  ["Language", book.data.language],
  ap?.edition ? ["Edition", ap.edition] : null,
  ap?.pages ? ["Extent", `${ap.pages} pp.`] : null,
  ap?.isbn ? ["ISBN", ap.isbn] : null,
  ap?.price ? ["Price", ap.price] : null,
  ap ? ["Kindle", ap.kindle ? "Available" : "Print only"] : null,
].filter(Boolean) as [string, string][];
---

<BaseLayout title={book.data.title} description={book.data.synopsis}>
  <article class="bk" style={`--mv: var(--mv-${book.data.movement}); --mv-lum: var(--mv-${book.data.movement}-lum)`}>
    <section class="bk__head">
      <TierField cx={82} cy={46} scale={0.85} pulseLine={false} class="bk__field" />

      <div class="bk__head-inner">
        <a href={`${base}books/`} class="bk__back link-draw">&larr; The Canon</a>

        <div class="bk__grid">
          <div class="bk__cover" data-reveal="scale" data-tilt="11">
            <BookCover
              title={book.data.title}
              subtitle={book.data.subtitle}
              movement={book.data.movement}
              shelf={book.data.shelf}
              cover={book.data.cover}
              year={book.data.year}
              loading="eager"
            />
          </div>

          <div class="bk__detail">
            <a href={`${base}books/#${book.data.movement}`} class="bk__movement" data-reveal="fade">
              <span class="bk__mv-num">{mv?.numeral}</span>
              {mv?.name}
              <span class="bk__mv-gloss">— {mv?.gloss}</span>
            </a>

            <h1 class="bk__title" data-reveal>{book.data.title}</h1>
            {book.data.subtitle && <p class="bk__subtitle" data-reveal data-reveal-delay="60">{book.data.subtitle}</p>}

            <p class="bk__synopsis" data-reveal data-reveal-delay="120">{book.data.synopsis}</p>

            {
              book.data.foreword && (
                <div class="bk__foreword" data-reveal data-reveal-delay="180">
                  <span class="bk__foreword-label">Foreword</span>
                  <span class="bk__foreword-name">{book.data.foreword}</span>
                </div>
              )
            }

            <div class="bk__actions" data-stagger data-reveal-delay="240">
              {
                ap?.amazon && (
                  <a href={ap.amazon} target="_blank" rel="noopener noreferrer" class="button button--solid">
                    Order on Amazon
                  </a>
                )
              }
              <a href={`${base}books/#${book.data.movement}`} class="button button--outline">
                More from {mv?.name}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bk__body">
      <div class="bk__body-grid">
        <div class="bk__prose">
          <Content />
        </div>

        <aside class="bk__apparatus" data-reveal="right">
          <div class="eyebrow bk__apparatus-head">Apparatus</div>
          <dl>
            {
              rows.map(([k, v]) => (
                <div class="bk__row">
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>

          <div class="bk__orders">
            <div class="eyebrow bk__apparatus-head">Orders</div>
            <p>
              Titles are available by correspondence with the house, and the listed editions through Amazon India.
            </p>
            <a href={`${base}imprint/`} class="link-draw bk__orders-link">The imprint &rarr;</a>
          </div>
        </aside>
      </div>
    </section>

    {
      sameMovement.length > 0 && (
        <section class="bk__also">
          <div class="bk__also-inner">
            <div class="bk__also-head" data-reveal>
              <span class="bk__also-rule" aria-hidden="true" />
              <h2>
                {mv?.numeral} · {mv?.name}
              </h2>
            </div>
            <div class="bk__also-shelf" data-stagger>
              {sameMovement.map((b) => (
                <a href={`${base}books/${b.id}/`} class="bk__also-item" data-tilt="8">
                  <BookCover
                    title={b.data.title}
                    subtitle={b.data.subtitle}
                    movement={b.data.movement}
                    shelf={b.data.shelf}
                    cover={b.data.cover}
                    year={b.data.year}
                  />
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <a href={`${base}books/${next.id}/`} class="bk__next" style={`--nc: var(--mv-${next.data.movement}-lum)`}>
      <span class="bk__next-label">Next in the canon</span>
      <span class="bk__next-title">{next.data.title}</span>
      <span class="bk__next-arrow" aria-hidden="true">&rarr;</span>
    </a>
  </article>
</BaseLayout>

<style>
  .bk__head {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--ink) 0%, var(--void) 100%);
    padding: clamp(40px, 6vh, 64px) var(--section-pad-x) clamp(60px, 10vh, 104px);
  }

  .bk__head::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(62% 62% at 28% 50%, rgba(16, 14, 46, 0.76) 0%, rgba(16, 14, 46, 0) 100%);
  }

  .bk__head-inner {
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .bk__back {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
    text-decoration: none;
    margin-bottom: 42px;
  }

  .bk__back:hover {
    color: var(--accent-lum);
  }

  .bk__grid {
    display: grid;
    grid-template-columns: minmax(190px, 272px) 1fr;
    gap: clamp(32px, 6vw, 78px);
    align-items: center;
  }

  .bk__cover {
    perspective: 1200px;
    transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-out);
  }

  .bk__movement {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mv-lum);
    text-decoration: none;
  }

  .bk__movement:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .bk__mv-num {
    font-family: var(--font-mono);
    border: 1px solid currentColor;
    padding: 2px 7px;
    letter-spacing: 0.06em;
  }

  .bk__mv-gloss {
    font-family: var(--font-display);
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    font-size: 13px;
    color: var(--ink-text-faint);
  }

  .bk__title {
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    margin: 18px 0 10px;
    color: var(--ink-text);
  }

  .bk__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.8vw, 1.4rem);
    color: var(--ink-text-muted);
    margin: 0 0 22px;
  }

  .bk__synopsis {
    font-size: clamp(1.06rem, 1.45vw, 1.25rem);
    line-height: 1.72;
    color: var(--ink-text-muted);
    max-width: 58ch;
    margin: 16px 0 26px;
  }

  .bk__foreword {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 16px 20px;
    border-left: 2px solid var(--mv-lum);
    background: rgba(38, 33, 99, 0.5);
    margin-bottom: 30px;
    max-width: 56ch;
  }

  .bk__foreword-label {
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
  }

  .bk__foreword-name {
    font-family: var(--font-display);
    font-size: 15.5px;
    color: var(--ink-text);
  }

  .bk__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---- body + apparatus ---- */
  .bk__body {
    background: var(--parchment);
    color: var(--graphite);
    padding: clamp(52px, 8vh, 92px) var(--section-pad-x);
  }

  .bk__body-grid {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 310px);
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }

  .bk__prose {
    font-size: clamp(1.1rem, 1.35vw, 1.24rem);
    line-height: 1.78;
    color: var(--light-text-muted);
    max-width: 66ch;
  }

  .bk__prose :global(p) {
    margin: 0 0 24px;
  }

  .bk__prose :global(p:first-child) {
    font-size: 1.1em;
    color: var(--ink);
  }

  .bk__prose:empty {
    display: none;
  }

  .bk__apparatus {
    border-top: 2px solid var(--ink);
    padding-top: 18px;
  }

  .bk__apparatus-head {
    color: var(--accent);
    margin-bottom: 14px;
  }

  .bk__apparatus dl {
    margin: 0;
  }

  .bk__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--light-hairline);
  }

  .bk__row dt {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--light-text-faint);
    flex: 0 0 auto;
  }

  .bk__row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-align: right;
    color: var(--ink);
  }

  .bk__orders {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--light-hairline);
  }

  .bk__orders p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--light-text-muted);
    margin: 0 0 12px;
  }

  .bk__orders-link {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }

  /* ---- also in movement ---- */
  .bk__also {
    background: var(--void);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x);
  }

  .bk__also-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .bk__also-head {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 28px;
  }

  .bk__also-rule {
    width: 26px;
    height: 2px;
    background: var(--mv-lum);
    flex: 0 0 auto;
  }

  .bk__also-head h2 {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    color: var(--ink-text);
  }

  .bk__also-shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
    perspective: 1400px;
  }

  .bk__also-item {
    display: block;
    text-decoration: none;
    transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.45s var(--ease-out);
  }

  /* ---- next ---- */
  .bk__next {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    background: var(--ink);
    border-top: 1px solid var(--ink-hairline);
    padding: clamp(34px, 6vh, 58px) var(--section-pad-x);
    text-decoration: none;
    color: var(--ink-text);
    position: relative;
    overflow: hidden;
  }

  .bk__next::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--nc) 18%, transparent), transparent 55%);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .bk__next:hover::before {
    opacity: 1;
  }

  .bk__next > * {
    position: relative;
  }

  .bk__next-label {
    font-family: var(--font-ui);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
    flex: 0 0 auto;
  }

  .bk__next-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    flex: 1;
  }

  .bk__next-arrow {
    color: var(--nc);
    font-size: 1.3rem;
    transition: transform var(--dur) var(--ease-out);
  }

  .bk__next:hover .bk__next-arrow {
    transform: translateX(8px);
  }

  @media (max-width: 860px) {
    .bk__body-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .bk__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .bk__cover {
      max-width: 200px;
    }
  }
</style>
