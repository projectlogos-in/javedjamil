---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BookCover from "../../components/BookCover.astro";
import { base } from "../../lib/base";
import { MOVEMENTS, HOUSE } from "../../lib/movements";

const books = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);

const grouped = MOVEMENTS.map((m) => ({
  ...m,
  books: books.filter((b) => b.data.movement === m.key).sort((a, b) => a.data.sortYear - b.data.sortYear),
}));

const years = books.map((b) => b.data.sortYear);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---

<BaseLayout
  title="The Canon"
  description="Twenty-five titles by Dr. Javed Jamil, published by Mission Publications — one argument in four movements."
>
  <PageHero
    eyebrow="Mission Publications"
    title="One argument, in four movements"
    lead="Twenty-five titles. The house has published a single author because it was founded to carry a single argument: the sources recovered, the present diagnosed, the programme set out, the teaching grounded."
    meta={[`${books.length} titles`, span, HOUSE.motto ? `${HOUSE.mottoGloss}` : ""].filter(Boolean)}
  >
    <div class="mv-key" data-reveal data-reveal-delay="280">
      {
        grouped.map((m) => (
          <a href={`#${m.key}`} class="mv-key__item" style={`--mv: var(--mv-${m.key}-lum)`}>
            <span class="mv-key__num">{m.numeral}</span>
            <span class="mv-key__name">{m.name}</span>
            <span class="mv-key__n">{m.books.length}</span>
          </a>
        ))
      }
    </div>
  </PageHero>

  <div class="canon">
    {
      grouped.map((m) => (
        <section class="mv" id={m.key} style={`--mv: var(--mv-${m.key}); --mv-lum: var(--mv-${m.key}-lum)`}>
          <div class="mv__head" data-reveal>
            <div class="mv__title-row">
              <span class="mv__numeral">{m.numeral}</span>
              <h2 class="mv__name">{m.name}</h2>
              <span class="mv__gloss">— {m.gloss}</span>
            </div>
            <p class="mv__statement">{m.statement}</p>
          </div>

          <div class="mv__shelf" data-stagger>
            {m.books.map((book) => (
              <a href={`${base}books/${book.id}/`} class="shelf-item" data-tilt="8">
                <BookCover
                  title={book.data.title}
                  subtitle={book.data.subtitle}
                  movement={book.data.movement}
                  shelf={book.data.shelf}
                  cover={book.data.cover}
                  year={book.data.year}
                />
                <span class="shelf-item__meta">
                  <span class="shelf-item__title">{book.data.title}</span>
                  <span class="shelf-item__year">
                    {book.data.year}
                    {book.data.language !== "English" ? ` · ${book.data.language}` : ""}
                  </span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .mv-key {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 34px;
  }

  .mv-key__item {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 16px;
    border: 1px solid var(--ink-hairline);
    text-decoration: none;
    color: var(--ink-text-muted);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .mv-key__item:hover {
    border-color: var(--mv);
    color: var(--ink-text);
    transform: translateY(-2px);
  }

  .mv-key__num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--mv);
  }

  .mv-key__name {
    font-family: var(--font-display);
    font-size: 16px;
  }

  .mv-key__n {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-text-faint);
  }

  .canon {
    background: var(--void);
    padding: clamp(48px, 7vh, 80px) var(--section-pad-x) clamp(70px, 11vh, 130px);
  }

  .mv {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(38px, 6vh, 64px) 0;
    border-top: 1px solid var(--ink-hairline);
    scroll-margin-top: 96px;
  }

  .mv:first-child {
    border-top: none;
    padding-top: 0;
  }

  .mv__head {
    margin-bottom: 34px;
    max-width: 72ch;
  }

  .mv__title-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .mv__numeral {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--mv-lum);
    border: 1px solid var(--mv-lum);
    padding: 3px 8px;
  }

  .mv__name {
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    color: var(--ink-text);
  }

  .mv__gloss {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-text-faint);
  }

  .mv__statement {
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: var(--ink-text-muted);
    margin: 0;
  }

  .mv__shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    gap: clamp(20px, 2.8vw, 36px);
    perspective: 1600px;
  }

  .shelf-item {
    display: flex;
    flex-direction: column;
    gap: 13px;
    text-decoration: none;
    color: var(--ink-text-muted);
    transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.45s var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .shelf-item:hover {
    color: var(--ink-text);
  }

  .shelf-item__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .shelf-item__title {
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.3;
  }

  .shelf-item__year {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-text-faint);
  }

  @media (max-width: 560px) {
    .mv__shelf {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
