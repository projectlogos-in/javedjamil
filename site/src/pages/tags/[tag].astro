---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { base } from "../../lib/base";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const poems = await getCollection("shayari", ({ data }) => !data.draft);
  const tags = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.add(t)));
  poems.forEach((p) => p.data.tags.forEach((t) => tags.add(t)));

  return [...tags].map((tag) => {
    const taggedPosts = posts
      .filter((p) => p.data.tags.includes(tag))
      .map((p) => ({ id: p.id, title: p.data.title, date: p.data.date, kind: "ideas" as const }));
    const taggedPoems = poems
      .filter((p) => p.data.tags.includes(tag))
      .map((p) => ({ id: p.id, title: p.data.title, date: p.data.date, kind: "shayari" as const }));
    const items = [...taggedPosts, ...taggedPoems].sort((a, b) => b.date.valueOf() - a.date.valueOf());
    return { params: { tag }, props: { tag, items } };
  });
}

const { tag, items } = Astro.props;
const readable = tag.replace(/-/g, " ");
---

<BaseLayout title={`#${tag}`} description={`Everything tagged "${readable}" by Dr. Javed Jamil.`}>
  <PageHero eyebrow="Tag" title={readable} meta={[`${items.length} ${items.length === 1 ? "piece" : "pieces"}`]} />

  <section class="tagged">
    <div class="tagged__inner" data-stagger>
      {
        items.map((item) => (
          <a href={`${base}${item.kind}/${item.id}/`} class="tagged__row">
            <span class="tagged__kind">{item.kind === "shayari" ? "Ghazal" : "Essay"}</span>
            <span class="tagged__title">{item.title}</span>
            <time class="tagged__date" datetime={item.date.toISOString()}>
              {item.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" })}
            </time>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .tagged {
    background: var(--void);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x) clamp(70px, 11vh, 130px);
  }

  .tagged__inner {
    max-width: 940px;
    margin: 0 auto;
    border-top: 1px solid var(--ink-hairline);
  }

  .tagged__row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 22px;
    align-items: baseline;
    padding: 22px 8px;
    border-bottom: 1px solid var(--ink-hairline);
    text-decoration: none;
    color: var(--ink-text);
    transition: padding-left var(--dur) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .tagged__row:hover {
    padding-left: 18px;
    background: rgba(47, 167, 149, 0.06);
  }

  .tagged__kind {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-lum);
  }

  .tagged__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.02rem, 1.7vw, 1.28rem);
    line-height: 1.28;
  }

  .tagged__date {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-text-faint);
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .tagged__row {
      grid-template-columns: 1fr auto;
      gap: 8px 16px;
    }

    .tagged__title {
      grid-column: 1 / -1;
    }
  }
</style>
