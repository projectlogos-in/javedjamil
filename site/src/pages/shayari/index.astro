---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { base } from "../../lib/base";

const poems = (await getCollection("shayari", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Shayari" description="Urdu ghazals by Dr. Javed Jamil.">
  <PageHero
    eyebrow="Shayari"
    title="Urdu poetry"
    lead="Several hundred ghazals, written alongside the polemic. His first collection, Rahguzar, was published by the Fakhruddin Memorial Committee. He has largely declined the mushaira circuit — the poetry stayed private work."
    meta={[`${poems.length} pieces`]}
    align="center"
  />

  <section class="ghazals">
    <div class="ghazals__inner" data-stagger>
      {
        poems.map((poem) => (
          <a href={`${base}shayari/${poem.id}/`} class="ghazal">
            <span class="ghazal__title">{poem.data.title}</span>
            <span class="ghazal__foot">
              <time datetime={poem.data.date.toISOString()}>
                {poem.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" })}
              </time>
              <span class="ghazal__read" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .ghazals {
    background: var(--void);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x) clamp(70px, 11vh, 130px);
  }

  .ghazals__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: 14px;
  }

  .ghazal {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 26px;
    min-height: 168px;
    padding: 26px 28px;
    background: linear-gradient(158deg, var(--ink-raised) 0%, var(--ink) 100%);
    border: 1px solid var(--ink-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-text);
    position: relative;
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  /* a faint gold arc in the corner — the ceremonial register, quietly */
  .ghazal::before {
    content: "";
    position: absolute;
    right: -54px;
    top: -54px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 1px solid var(--gold-lum);
    opacity: 0.16;
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .ghazal:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--gold-lum) 42%, transparent);
  }

  .ghazal:hover::before {
    opacity: 0.4;
    transform: scale(1.14);
  }

  .ghazal__title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: 1.16rem;
    line-height: 1.34;
  }

  .ghazal__foot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
  }

  .ghazal__read {
    color: var(--gold-lum);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .ghazal:hover .ghazal__read {
    opacity: 1;
    transform: none;
  }
</style>
