---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import { base } from "../../../lib/base";
import { slugify } from "../../../lib/slugify";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.type === "series" && !data.draft);
  const seriesNames = [...new Set(posts.map((p) => p.data.seriesName).filter(Boolean))] as string[];

  return seriesNames.map((name) => {
    const parts = posts
      .filter((p) => p.data.seriesName === name)
      .sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0));
    return { params: { series: slugify(name) }, props: { name, parts } };
  });
}

const { name, parts } = Astro.props;
const span = {
  from: parts[0]?.data.date,
  to: parts[parts.length - 1]?.data.date,
};
---

<BaseLayout title={name} description={`All parts of the series "${name}" by Dr. Javed Jamil.`}>
  <PageHero
    eyebrow="Series"
    title={name}
    meta={[
      `${parts.length} parts`,
      span.from
        ? `${span.from.toLocaleDateString("en-GB", { month: "short", year: "numeric" })} — ${span.to?.toLocaleDateString("en-GB", { month: "short", year: "numeric" })}`
        : "",
    ].filter(Boolean)}
  />

  <section class="parts">
    <div class="parts__inner">
      <ol class="parts__list" data-stagger>
        {
          parts.map((part, i) => (
            <li>
              <a href={`${base}ideas/${part.id}/`} class="part">
                <span class="part__rail" aria-hidden="true">
                  <span class="part__dot" />
                  {i < parts.length - 1 && <span class="part__line" />}
                </span>
                <span class="part__n">Part {i + 1}</span>
                <span class="part__body">
                  <span class="part__title">{part.data.title}</span>
                  {part.data.excerpt && <span class="part__excerpt">{part.data.excerpt}</span>}
                </span>
                <span class="part__arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ol>

      <a href={`${base}ideas/`} class="button button--outline parts__back">All essays &amp; series</a>
    </div>
  </section>
</BaseLayout>

<style>
  .parts {
    background: var(--void);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x) clamp(70px, 11vh, 130px);
  }

  .parts__inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .parts__list {
    list-style: none;
    margin: 0 0 44px;
    padding: 0;
  }

  /* a connected spine down the left, so the sequence reads as one argument */
  .part {
    display: grid;
    grid-template-columns: 26px 78px 1fr 24px;
    gap: 18px;
    align-items: start;
    padding: 22px 16px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-text);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .part:hover {
    background: var(--ink-raised);
  }

  .part__rail {
    position: relative;
    display: flex;
    justify-content: center;
    align-self: stretch;
    padding-top: 7px;
  }

  .part__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--void);
    border: 2px solid var(--accent-lum);
    z-index: 1;
    flex: 0 0 auto;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .part:hover .part__dot {
    background: var(--accent-lum);
  }

  .part__line {
    position: absolute;
    top: 17px;
    bottom: -30px;
    width: 1px;
    background: var(--ink-hairline-strong);
  }

  .part__n {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-lum);
    padding-top: 5px;
  }

  .part__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.9vw, 1.4rem);
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .part__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-text-faint);
  }

  .part__arrow {
    justify-self: end;
    padding-top: 6px;
    color: var(--accent-lum);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .part:hover .part__arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .part {
      grid-template-columns: 20px 1fr;
      gap: 12px;
    }

    .part__n {
      padding-top: 0;
    }

    .part__body {
      grid-column: 2;
    }

    .part__arrow {
      display: none;
    }
  }
</style>
