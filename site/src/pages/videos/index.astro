---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import videoData from "../../data/videos.json";

const { videos, handle } = videoData;
const [lead, ...rest] = videos;
const channelUrl = `https://www.youtube.com/@${handle}`;
---

<BaseLayout
  title="Lectures"
  description="Lectures and conversations by Dr. Javed Jamil, from the IMAN channel."
>
  <PageHero
    eyebrow="IMAN · YouTube"
    title="Lectures & conversations"
    lead="The argument delivered aloud — lectures, interviews and readings, in English and Urdu, from the channel the house publishes to."
    meta={[`${videos.length} recent`, "youtube.com/@DiscoverIman"]}
  >
    <a href={channelUrl} target="_blank" rel="noopener noreferrer" class="button button--outline vid-hero__cta" data-reveal data-reveal-delay="300">
      Open the channel &rarr;
    </a>
  </PageHero>

  {
    lead && (
      <section class="feature">
        <div class="feature__inner">
          <div class="feature__player" data-reveal="scale">
            <lite-yt data-id={lead.id} data-title={lead.title}>
              <button class="lyt" type="button" aria-label={`Play: ${lead.title}`}>
                <img src={lead.thumb} alt="" loading="eager" width="480" height="360" />
                <span class="lyt__play" aria-hidden="true">
                  <svg viewBox="0 0 68 48" width="62">
                    <path d="M66.5 7.7a8 8 0 0 0-5.6-5.7C56 .7 34 .7 34 .7s-22 0-26.9 1.3A8 8 0 0 0 1.5 7.7 83 83 0 0 0 .2 24a83 83 0 0 0 1.3 16.3 8 8 0 0 0 5.6 5.7C12 47.3 34 47.3 34 47.3s22 0 26.9-1.3a8 8 0 0 0 5.6-5.7A83 83 0 0 0 67.8 24a83 83 0 0 0-1.3-16.3z" fill="#A5392A" />
                    <path d="M27 34V14l18 10-18 10z" fill="#fff" />
                  </svg>
                </span>
              </button>
            </lite-yt>
          </div>

          <div class="feature__meta" data-reveal>
            <div class="eyebrow">Most recent</div>
            <h2 class="feature__title">{lead.title}</h2>
            {lead.blurb && <p class="feature__blurb">{lead.blurb}</p>}
            <time class="feature__date" datetime={lead.published}>
              {new Date(lead.published).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </div>
        </div>
      </section>
    )
  }

  <section class="grid-sec">
    <div class="grid-sec__inner">
      <div class="grid-sec__head" data-reveal>
        <div class="eyebrow eyebrow--dim">Earlier</div>
      </div>

      <div class="vgrid" data-stagger>
        {
          rest.map((v) => (
            <lite-yt class="vcard" data-id={v.id} data-title={v.title}>
              <button class="lyt" type="button" aria-label={`Play: ${v.title}`}>
                <img src={v.thumb} alt="" loading="lazy" width="480" height="360" />
                <span class="lyt__play" aria-hidden="true">
                  <svg viewBox="0 0 68 48" width="46">
                    <path d="M66.5 7.7a8 8 0 0 0-5.6-5.7C56 .7 34 .7 34 .7s-22 0-26.9 1.3A8 8 0 0 0 1.5 7.7 83 83 0 0 0 .2 24a83 83 0 0 0 1.3 16.3 8 8 0 0 0 5.6 5.7C12 47.3 34 47.3 34 47.3s22 0 26.9-1.3a8 8 0 0 0 5.6-5.7A83 83 0 0 0 67.8 24a83 83 0 0 0-1.3-16.3z" fill="#A5392A" />
                    <path d="M27 34V14l18 10-18 10z" fill="#fff" />
                  </svg>
                </span>
              </button>
              <span class="vcard__meta">
                <span class="vcard__title">{v.title}</span>
                <time class="vcard__date" datetime={v.published}>
                  {new Date(v.published).toLocaleDateString("en-GB", { year: "numeric", month: "short" })}
                </time>
              </span>
            </lite-yt>
          ))
        }
      </div>

      <a href={channelUrl} target="_blank" rel="noopener noreferrer" class="button button--outline grid-sec__all" data-reveal>
        The full channel on YouTube &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  /*
    Facade embeds: we ship the thumbnail only, and swap in the real iframe on
    click. Nothing is requested from YouTube until the visitor asks for it —
    which keeps the page fast and avoids loading their cookies on arrival.
  */
  class LiteYt extends HTMLElement {
    connectedCallback() {
      this.querySelector("button")?.addEventListener("click", () => this.activate(), { once: true });
    }

    activate() {
      const id = this.dataset.id;
      const frame = document.createElement("iframe");
      frame.width = "560";
      frame.height = "315";
      frame.title = this.dataset.title ?? "Video";
      frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      frame.allowFullscreen = true;
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      this.querySelector("button")?.replaceWith(frame);
    }
  }

  if (!customElements.get("lite-yt")) customElements.define("lite-yt", LiteYt);
</script>

<style>
  .vid-hero__cta {
    margin-top: 30px;
  }

  /* ---- shared facade ---- */
  .lyt {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    background: var(--void);
    cursor: pointer;
    overflow: hidden;
  }

  .lyt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* the feed's hqdefault is 4:3 with pillar bars — crop to the 16:9 frame */
    transform: scale(1.36);
    transition: transform var(--dur) var(--ease-out), filter var(--dur) var(--ease-out);
    filter: saturate(0.9);
  }

  .lyt:hover img {
    transform: scale(1.42);
    filter: saturate(1.05);
  }

  .lyt__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(16, 14, 46, 0.1) 0%, rgba(16, 14, 46, 0.55) 100%);
    transition: background-color var(--dur) var(--ease-out);
  }

  .lyt__play svg {
    filter: drop-shadow(0 4px 16px rgba(16, 14, 46, 0.6));
    transition: transform var(--dur) var(--ease-out);
  }

  .lyt:hover .lyt__play svg {
    transform: scale(1.09);
  }

  lite-yt iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    display: block;
  }

  /* ---- feature ---- */
  .feature {
    background: var(--void);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x);
  }

  .feature__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .feature__player {
    box-shadow: var(--lift-3);
  }

  .feature__title {
    font-size: clamp(1.4rem, 2.6vw, 2.05rem);
    line-height: 1.14;
    margin: 16px 0 16px;
    color: var(--ink-text);
  }

  .feature__blurb {
    font-size: 15.5px;
    line-height: 1.68;
    color: var(--ink-text-muted);
    margin: 0 0 18px;
  }

  .feature__date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-text-faint);
  }

  /* ---- grid ---- */
  .grid-sec {
    background: var(--ink);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x) clamp(70px, 11vh, 120px);
    border-top: 1px solid var(--ink-hairline);
    text-align: center;
  }

  .grid-sec__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    text-align: left;
  }

  .grid-sec__head {
    margin-bottom: 24px;
  }

  .vgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: clamp(20px, 2.6vw, 32px);
  }

  .vcard {
    display: flex;
    flex-direction: column;
    gap: 13px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .vcard:hover {
    transform: translateY(-4px);
  }

  .vcard__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vcard__title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.32;
    color: var(--ink-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .vcard__date {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink-text-faint);
  }

  .grid-sec__all {
    display: inline-flex;
    margin: 44px auto 0;
  }

  .grid-sec {
    display: flex;
    flex-direction: column;
  }

  .grid-sec__inner {
    width: 100%;
  }

  @media (max-width: 860px) {
    .feature__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
