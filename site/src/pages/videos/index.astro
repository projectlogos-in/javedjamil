---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import videoData from "../../data/videos.json";

const { videos, handle, complete } = videoData;
const [lead, ...rest] = videos;
const channelUrl = `https://www.youtube.com/@${handle}`;

// group the archive by year so a long list stays navigable
const byYear = new Map<string, typeof rest>();
for (const v of rest) {
  const y = v.published.slice(0, 4) || "Undated";
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(v);
}
const years = [...byYear.entries()].sort((a, b) => b[0].localeCompare(a[0]));

const span = videos.length
  ? (() => {
      const dates = videos.map((v) => v.published).filter(Boolean).sort();
      const from = dates[0]?.slice(0, 4);
      const to = dates[dates.length - 1]?.slice(0, 4);
      return from && to && from !== to ? `${from}–${to}` : from;
    })()
  : "";
---

<BaseLayout title="Lectures" description="Lectures and conversations by Dr. Javed Jamil, from the IMAN channel.">
  <PageHero
    eyebrow="IMAN · YouTube"
    title="Lectures & conversations"
    lead="The argument delivered aloud — lectures, readings and interviews, in English and Urdu, from the channel the house publishes to."
    meta={[`${videos.length} ${complete ? "lectures" : "recent"}`, span, "@DiscoverIman"].filter(Boolean)}
  >
    <a
      href={channelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="button button--outline vid-hero__cta"
      data-reveal
      data-reveal-delay="300">Open the channel &rarr;</a
    >
  </PageHero>

  {
    lead && (
      <section class="feature">
        <div class="feature__inner">
          <div class="feature__player" data-reveal="scale">
            <lite-yt data-id={lead.id} data-title={lead.title}>
              <button class="lyt" type="button" aria-label={`Play: ${lead.title}`}>
                <img src={lead.thumb} alt="" loading="eager" width="480" height="360" />
                <span class="lyt__play" aria-hidden="true">
                  <svg viewBox="0 0 68 48" width="62">
                    <path
                      d="M66.5 7.7a8 8 0 0 0-5.6-5.7C56 .7 34 .7 34 .7s-22 0-26.9 1.3A8 8 0 0 0 1.5 7.7 83 83 0 0 0 .2 24a83 83 0 0 0 1.3 16.3 8 8 0 0 0 5.6 5.7C12 47.3 34 47.3 34 47.3s22 0 26.9-1.3a8 8 0 0 0 5.6-5.7A83 83 0 0 0 67.8 24a83 83 0 0 0-1.3-16.3z"
                      fill="#A5392A"
                    />
                    <path d="M27 34V14l18 10-18 10z" fill="#fff" />
                  </svg>
                </span>
                {lead.duration && <span class="lyt__dur">{lead.duration}</span>}
              </button>
            </lite-yt>
          </div>

          <div class="feature__meta" data-reveal>
            <div class="eyebrow">Most recent</div>
            <h2 class="feature__title">{lead.title}</h2>
            {lead.blurb && <p class="feature__blurb">{lead.blurb}</p>}
            <time class="feature__date" datetime={lead.published}>
              {new Date(lead.published).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </div>
        </div>
      </section>
    )
  }

  <section class="archive">
    <div class="archive__inner">
      {
        years.map(([year, items]) => (
          <div class="year">
            <div class="year__head" data-reveal="fade">
              <span class="year__num">{year}</span>
              <span class="year__rule" aria-hidden="true" />
              <span class="year__count">{items.length}</span>
            </div>

            <div class="vgrid" data-stagger>
              {items.map((v) => (
                <lite-yt class="vcard" data-id={v.id} data-title={v.title}>
                  <button class="lyt" type="button" aria-label={`Play: ${v.title}`}>
                    <img src={v.thumb} alt="" loading="lazy" width="480" height="360" />
                    <span class="lyt__play" aria-hidden="true">
                      <svg viewBox="0 0 68 48" width="44">
                        <path
                          d="M66.5 7.7a8 8 0 0 0-5.6-5.7C56 .7 34 .7 34 .7s-22 0-26.9 1.3A8 8 0 0 0 1.5 7.7 83 83 0 0 0 .2 24a83 83 0 0 0 1.3 16.3 8 8 0 0 0 5.6 5.7C12 47.3 34 47.3 34 47.3s22 0 26.9-1.3a8 8 0 0 0 5.6-5.7A83 83 0 0 0 67.8 24a83 83 0 0 0-1.3-16.3z"
                          fill="#A5392A"
                        />
                        <path d="M27 34V14l18 10-18 10z" fill="#fff" />
                      </svg>
                    </span>
                    {v.duration && <span class="lyt__dur">{v.duration}</span>}
                  </button>
                  <span class="vcard__meta">
                    <span class="vcard__title">{v.title}</span>
                    <time class="vcard__date" datetime={v.published}>
                      {new Date(v.published).toLocaleDateString("en-GB", { day: "2-digit", month: "short" })}
                    </time>
                  </span>
                </lite-yt>
              ))}
            </div>
          </div>
        ))
      }

      <a href={channelUrl} target="_blank" rel="noopener noreferrer" class="button button--outline archive__all" data-reveal>
        {complete ? "Watch on YouTube" : "The full channel on YouTube"} &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  /*
    Facade embeds: ship the thumbnail only, swap in the real iframe on click.
    Nothing is requested from YouTube until the visitor asks for it, which
    keeps a page of 100+ lectures fast and loads no third-party cookies on
    arrival.
  */
  class LiteYt extends HTMLElement {
    connectedCallback() {
      this.querySelector("button")?.addEventListener("click", () => this.activate(), { once: true });
    }

    activate() {
      const frame = document.createElement("iframe");
      frame.width = "560";
      frame.height = "315";
      frame.title = this.dataset.title ?? "Video";
      frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      frame.allowFullscreen = true;
      frame.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0`;
      this.querySelector("button")?.replaceWith(frame);
    }
  }

  if (!customElements.get("lite-yt")) customElements.define("lite-yt", LiteYt);
</script>

<style>
  .vid-hero__cta {
    margin-top: 30px;
  }

  /* ---- shared facade ---- */
  .lyt {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    background: var(--void);
    cursor: pointer;
    overflow: hidden;
  }

  .lyt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform var(--dur) var(--ease-out), filter var(--dur) var(--ease-out);
  }

  .lyt:hover img {
    transform: scale(1.05);
    filter: saturate(1.05);
  }

  .lyt__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(16, 14, 46, 0.08) 0%, rgba(16, 14, 46, 0.52) 100%);
  }

  .lyt__play svg {
    filter: drop-shadow(0 4px 16px rgba(16, 14, 46, 0.6));
    transition: transform var(--dur) var(--ease-out);
  }

  .lyt:hover .lyt__play svg {
    transform: scale(1.09);
  }

  .lyt__dur {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 3px 7px;
    background: rgba(16, 14, 46, 0.88);
    color: var(--ink-text);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }

  lite-yt iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    display: block;
  }

  /* ---- feature ---- */
  .feature {
    background: var(--void);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x);
  }

  .feature__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .feature__player {
    box-shadow: var(--lift-3);
  }

  .feature__title {
    font-size: clamp(1.4rem, 2.6vw, 2.05rem);
    line-height: 1.14;
    margin: 16px 0 16px;
    color: var(--ink-text);
  }

  .feature__blurb {
    font-size: 15.5px;
    line-height: 1.68;
    color: var(--ink-text-muted);
    margin: 0 0 18px;
  }

  .feature__date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-text-faint);
  }

  /* ---- archive ---- */
  .archive {
    background: var(--ink);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x) clamp(70px, 11vh, 120px);
    border-top: 1px solid var(--ink-hairline);
  }

  .archive__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .year + .year {
    margin-top: clamp(40px, 6vh, 64px);
  }

  .year__head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .year__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--ink-text);
  }

  .year__rule {
    flex: 1;
    height: 1px;
    background: var(--ink-hairline);
  }

  .year__count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--ink-text-faint);
  }

  .vgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
    gap: clamp(18px, 2.4vw, 30px);
  }

  .vcard {
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .vcard:hover {
    transform: translateY(-4px);
  }

  .vcard__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vcard__title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.32;
    color: var(--ink-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .vcard__date {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink-text-faint);
  }

  .archive__all {
    align-self: center;
    margin-top: clamp(44px, 7vh, 72px);
  }

  @media (max-width: 860px) {
    .feature__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
