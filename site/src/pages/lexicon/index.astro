---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { base } from "../../lib/base";

const terms = (await getCollection("lexicon")).sort((a, b) => a.data.term.localeCompare(b.data.term));
---

<BaseLayout title="Lexicon" description="A glossary of the terms Dr. Javed Jamil coined to make his argument.">
  <PageHero
    eyebrow="The Lexicon"
    title="He had to coin the terms first"
    lead="An argument this far outside the consensus needs vocabulary the consensus doesn't supply. Each entry links to the essays and books that build it."
    meta={[`${terms.length} entries`]}
  />

  <section class="terms">
    <div class="terms__inner" data-stagger>
      {
        terms.map((term, i) => (
          <a href={`${base}lexicon/${term.id}/`} class="term-card">
            <span class="term-card__index">{String(i + 1).padStart(2, "0")}</span>
            <span class="term-card__body">
              <span class="term-card__term">{term.data.term}</span>
              {term.data.category && <span class="term-card__cat">{term.data.category}</span>}
            </span>
            <span class="term-card__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .terms {
    background: var(--void);
    padding: clamp(48px, 8vh, 86px) var(--section-pad-x) clamp(70px, 11vh, 130px);
  }

  .terms__inner {
    max-width: 940px;
    margin: 0 auto;
    display: grid;
    gap: 14px;
  }

  .term-card {
    display: grid;
    grid-template-columns: 46px 1fr 30px;
    align-items: center;
    gap: 20px;
    padding: 28px 30px;
    background: var(--ink-raised);
    border: 1px solid var(--ink-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-text);
    position: relative;
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .term-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--accent-lum), var(--gold-lum));
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform var(--dur) var(--ease-out);
  }

  .term-card:hover {
    transform: translateX(8px);
    background: var(--ink-lifted);
    border-color: var(--ink-hairline-strong);
  }

  .term-card:hover::before {
    transform: scaleY(1);
  }

  .term-card__index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--accent-lum);
  }

  .term-card__body {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .term-card__term {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    line-height: 1.14;
  }

  .term-card__cat {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
  }

  .term-card__arrow {
    justify-self: end;
    color: var(--accent-lum);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .term-card:hover .term-card__arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 620px) {
    .term-card {
      grid-template-columns: 34px 1fr;
      padding: 22px 20px;
      gap: 14px;
    }

    .term-card__arrow {
      display: none;
    }
  }
</style>
