---
import BaseLayout from "../layouts/BaseLayout.astro";
import Seal from "../components/Seal.astro";
import TierField from "../components/TierField.astro";
import { base } from "../lib/base";

const routes = [
  { href: `${base}ideas/`, label: "Ideas" },
  { href: `${base}health-maximisation/`, label: "Health Maximisation" },
  { href: `${base}books/`, label: "Works" },
  { href: `${base}lexicon/`, label: "Lexicon" },
  { href: `${base}shayari/`, label: "Shayari" },
  { href: `${base}about/`, label: "About" },
];
---

<BaseLayout title="Page not found">
  <section class="nf">
    <TierField cx={50} cy={48} scale={1.4} class="nf__field" />

    <div class="nf__inner">
      <Seal variant="geometric" mode="dark" size={82} class="nf__seal" />
      <div class="eyebrow" data-reveal="fade">Error 404</div>
      <h1 class="nf__title" data-reveal>This tier does not exist</h1>
      <p class="nf__body" data-reveal data-reveal-delay="100">
        The page has moved, or was never at this address. Everything the site holds is one of these:
      </p>

      <nav class="nf__routes" data-stagger data-reveal-delay="180">
        {routes.map((r) => <a href={r.href} class="nf__route">{r.label}</a>)}
      </nav>

      <a href={base} class="button button--solid nf__home" data-reveal data-reveal-delay="300">Return to the centre</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    min-height: 78vh;
    display: flex;
    align-items: center;
    background: radial-gradient(80% 70% at 50% 46%, var(--ink-raised) 0%, var(--ink) 44%, var(--void) 100%);
    padding: clamp(70px, 12vh, 130px) var(--section-pad-x);
    text-align: center;
  }

  .nf__inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nf__seal {
    margin-bottom: 28px;
  }

  .nf__title {
    font-size: var(--step-xl);
    margin: 16px 0 18px;
    color: var(--ink-text);
  }

  .nf__body {
    font-size: var(--step-md);
    line-height: 1.65;
    color: var(--ink-text-muted);
    margin: 0 0 30px;
  }

  .nf__routes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 36px;
  }

  .nf__route {
    padding: 10px 18px;
    border: 1px solid var(--ink-hairline);
    border-radius: 100px;
    font-size: 13.5px;
    text-decoration: none;
    color: var(--ink-text-muted);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .nf__route:hover {
    border-color: var(--accent-lum);
    color: var(--ink-text);
    transform: translateY(-2px);
  }
</style>
