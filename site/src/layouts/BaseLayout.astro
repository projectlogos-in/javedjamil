---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { base } from "../lib/base";
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
  /** Set true for the reading-focused templates (posts, shayari) that want a parchment scroll ground. */
  bodyClass?: string;
}

const {
  title,
  description = "Dr. Javed Jamil — physician, Islamic scholar, and originator of Applied Islamics. Examining the modern world through the Qur'an.",
  bodyClass = "",
} = Astro.props;

const pageTitle = title === "Dr. Javed Jamil" ? title : `${title} — Dr. Javed Jamil`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@drjavedjamil" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..700&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Nastaliq+Urdu:wght@400;500;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
