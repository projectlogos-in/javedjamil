---
import BaseLayout from "./BaseLayout.astro";
import TierField from "../components/TierField.astro";
import Seal from "../components/Seal.astro";
import { base } from "../lib/base";

interface SeriesInfo {
  name: string;
  part: number;
  totalParts: number;
  seriesHref: string;
  prevHref?: string;
  nextHref?: string;
  prevTitle?: string;
  nextTitle?: string;
}

interface Props {
  title: string;
  date: Date;
  eyebrow: string;
  excerpt?: string;
  series?: SeriesInfo;
  tags?: string[];
  readingMinutes?: number;
}

const { title, date, eyebrow, excerpt, series, tags = [], readingMinutes } = Astro.props;

const dateLabel = date.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={title} description={excerpt} readProgress>
  <article class="post">
    <!-- masthead sits on the dark ground; the reading column below is paper -->
    <header class="post__masthead">
      <TierField cx={84} cy={40} scale={0.8} pulseLine={false} class="post__field" />

      <div class="post__masthead-inner">
        <a href={`${base}ideas/`} class="post__back link-draw">&larr; Ideas</a>

        <div class="eyebrow post__eyebrow" data-reveal="fade">{eyebrow}</div>
        <h1 class="post__title" data-reveal>{title}</h1>

        <div class="post__meta" data-reveal data-reveal-delay="120">
          <span>Dr. Javed Jamil</span>
          <span class="post__meta-dot" aria-hidden="true">&middot;</span>
          <time datetime={date.toISOString()}>{dateLabel}</time>
          {
            readingMinutes && (
              <>
                <span class="post__meta-dot" aria-hidden="true">&middot;</span>
                <span>{readingMinutes} min read</span>
              </>
            )
          }
        </div>

        {
          series && (
            <a href={series.seriesHref} class="post__series" data-reveal data-reveal-delay="180">
              <span class="post__series-rail">
                {Array.from({ length: series.totalParts }).map((_, i) => (
                  <span class:list={["post__series-tick", { "is-current": i + 1 === series.part }]} />
                ))}
              </span>
              <span class="post__series-text">
                <span class="post__series-name">{series.name}</span>
                <span class="post__series-part">
                  Part {series.part} of {series.totalParts}
                </span>
              </span>
            </a>
          )
        }
      </div>
    </header>

    <div class="post__sheet">
      <div class="post__body">
        <slot />
      </div>

      <footer class="post__footer">
        {
          tags.length > 0 && (
            <div class="post__tags">
              {tags.map((tag) => (
                <a href={`${base}tags/${tag}/`} class="post__tag">
                  {tag}
                </a>
              ))}
            </div>
          )
        }

        <div class="post__sign">
          <Seal size={30} mode="light" animated={false} />
          <span>Dr. Javed Jamil</span>
        </div>
      </footer>
    </div>

    {
      series && (series.prevHref || series.nextHref) && (
        <nav class="post__pager" aria-label="Series navigation">
          {series.prevHref ? (
            <a href={series.prevHref} class="post__pager-link post__pager-link--prev">
              <span class="post__pager-dir">&larr; Previous part</span>
              <span class="post__pager-title">{series.prevTitle}</span>
            </a>
          ) : (
            <span />
          )}
          {series.nextHref ? (
            <a href={series.nextHref} class="post__pager-link post__pager-link--next">
              <span class="post__pager-dir">Next part &rarr;</span>
              <span class="post__pager-title">{series.nextTitle}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    background: var(--parchment);
  }

  /* ---- masthead ---- */
  .post__masthead {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--ink) 0%, var(--void) 100%);
    padding: clamp(48px, 7vh, 78px) var(--section-pad-x) clamp(78px, 12vh, 130px);
  }

  .post__masthead::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(100deg, var(--void) 0%, rgba(4, 6, 14, 0.66) 34%, rgba(4, 6, 14, 0) 72%);
  }

  .post__masthead-inner {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
  }

  .post__back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
    text-decoration: none;
    margin-bottom: 40px;
  }

  .post__back:hover {
    color: var(--accent-lum);
  }

  .post__title {
    font-size: clamp(2.1rem, 5.2vw, 4rem);
    line-height: 1.04;
    margin: 18px 0 24px;
    color: var(--ink-text);
    max-width: 22ch;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--ink-text-faint);
  }

  .post__meta-dot {
    opacity: 0.5;
  }

  /* series indicator: a rail of ticks, current one lit */
  .post__series {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin-top: 34px;
    padding: 14px 22px;
    background: rgba(14, 20, 48, 0.7);
    border: 1px solid var(--ink-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-text);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .post__series:hover {
    border-color: var(--accent-lum);
  }

  .post__series-rail {
    display: flex;
    gap: 4px;
    flex: 0 0 auto;
  }

  .post__series-tick {
    display: block;
    width: 16px;
    height: 3px;
    border-radius: 2px;
    background: var(--ink-hairline-strong);
  }

  .post__series-tick.is-current {
    background: var(--accent-lum);
  }

  .post__series-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .post__series-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
  }

  .post__series-part {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-text-faint);
  }

  /* ---- the reading sheet: lifted off the masthead like a page ---- */
  .post__sheet {
    position: relative;
    z-index: 3;
    max-width: 820px;
    margin: -56px auto 0;
    background: var(--paper);
    border-radius: var(--radius-lg);
    box-shadow: var(--lift-3);
    padding: clamp(40px, 6vw, 76px) clamp(24px, 5vw, 72px) clamp(36px, 5vw, 56px);
  }

  .post__body {
    max-width: var(--reading-max);
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: clamp(1.06rem, 1.28vw, 1.19rem);
    line-height: 1.78;
    color: #26262b;
  }

  .post__body :global(p) {
    margin: 0 0 26px;
  }

  /* drop cap on the opening paragraph only */
  .post__body :global(> p:first-of-type)::first-letter {
    float: left;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 4.6em;
    line-height: 0.79;
    padding: 0.06em 0.12em 0 0;
    color: var(--accent);
  }

  .post__body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.16;
    margin: 52px 0 20px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .post__body :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    margin: 40px 0 16px;
    color: var(--ink);
  }

  .post__body :global(h4),
  .post__body :global(h5) {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 36px 0 14px;
    font-weight: 500;
  }

  .post__body :global(blockquote) {
    margin: 34px 0;
    padding: 4px 0 4px 30px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.32em;
    line-height: 1.44;
    color: var(--ink);
  }

  .post__body :global(blockquote p) {
    margin-bottom: 14px;
  }

  .post__body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post__body :global(a) {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: 24px;
    margin: 0 0 26px;
  }

  .post__body :global(li) {
    margin-bottom: 9px;
  }

  .post__body :global(li)::marker {
    color: var(--accent);
  }

  .post__body :global(img) {
    border-radius: var(--radius-md);
    margin: 12px 0 30px;
    box-shadow: var(--lift-1);
  }

  .post__body :global(figure) {
    margin: 0 0 30px;
  }

  .post__body :global(iframe) {
    max-width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border-radius: var(--radius-md);
    margin: 12px 0 30px;
    border: 0;
  }

  .post__body :global(hr) {
    border: 0;
    height: 1px;
    background: var(--light-hairline);
    margin: 44px 0;
  }

  .post__body :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
    margin: 0 0 28px;
    display: block;
    overflow-x: auto;
  }

  .post__body :global(th),
  .post__body :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--light-hairline);
  }

  /* ---- footer of the sheet ---- */
  .post__footer {
    max-width: var(--reading-max);
    margin: 46px auto 0;
    padding-top: 26px;
    border-top: 1px solid var(--light-hairline);
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
  }

  .post__tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .post__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--light-text-faint);
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid var(--light-hairline);
    border-radius: 100px;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .post__tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post__sign {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--light-text-muted);
  }

  /* ---- series pager ---- */
  .post__pager {
    max-width: 820px;
    margin: 0 auto;
    padding: 44px var(--section-pad-x) clamp(60px, 9vh, 100px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .post__pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px;
    background: var(--paper);
    border: 1px solid var(--light-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--graphite);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .post__pager-link:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .post__pager-link--next {
    text-align: right;
  }

  .post__pager-dir {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .post__pager-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.24;
  }

  @media (max-width: 700px) {
    .post__sheet {
      margin-top: -34px;
      border-radius: var(--radius-md);
    }

    .post__pager {
      grid-template-columns: 1fr;
    }

    .post__pager-link--next {
      text-align: left;
    }
  }
</style>
